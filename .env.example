NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma-separated additional trusted frontend origins (for example, an exact ngrok URL).
CLIENT_ADDITIONAL_ORIGINS=
MONGODB_URI=mongodb://localhost:27017/dg-energy
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
COOKIE_SECURE=false
MEDIA_STORAGE_ROOT=uploads
# Production defaults to private MongoDB GridFS; local disk is for development.
MEDIA_STORAGE_DRIVER=local
# Fresh production DB only; never overwrites existing accounts. Remove after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_API_URL=/api
VITE_VAPID_PUBLIC_KEY=
